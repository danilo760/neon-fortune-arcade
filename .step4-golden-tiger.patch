+
+/* =====================================================================
+   PASS 4 — CONTINUOUS REEL CABINET + HUD CLEANUP
+   Presentation-only. Math, payout and settlement are intentionally untouched.
+   ===================================================================== */
+.gt-hw-page .gt-premium-machine {
+  grid-template-rows: 44px 146px 0 minmax(300px, 1fr) 30px 38px 70px 10px;
+  gap: 3px;
+}
+
+.gt-hw-page .gt-premium-machine .gt-hw-brand small,
+.gt-hw-page .gt-premium-machine .gt-hw-brand > span {
+  display: none !important;
+}
+
+.gt-hw-page .gt-premium-machine .gt-hw-brand h1 {
+  margin: 0;
+  font-size: 21px;
+  letter-spacing: .055em;
+}
+
+/* Pull the mascot into the cabinet crown instead of leaving it floating. */
+.gt-hw-page .gt-premium-machine .gt-hw-tiger-stage {
+  z-index: 19;
+  transform: translateY(8px);
+  margin-bottom: -12px;
+}
+.gt-hw-page .gt-premium-machine .gt-hw-tiger-floor-shadow {
+  bottom: -2px;
+  width: 146px;
+  height: 20px;
+  opacity: .92;
+  filter: blur(7px);
+}
+.gt-hw-page .gt-premium-machine .gt-hw-tiger-stage::after {
+  content: "";
+  position: absolute;
+  z-index: -1;
+  left: 50%;
+  bottom: -8px;
+  width: 74%;
+  height: 26px;
+  transform: translateX(-50%);
+  border-radius: 50%;
+  background: radial-gradient(ellipse, rgba(255,198,71,.22), rgba(87,12,5,.48) 50%, transparent 72%);
+  box-shadow: 0 10px 18px rgba(0,0,0,.45);
+}
+
+/* Base-state rule labels are removed. Fortune telemetry only appears while active. */
+.gt-hw-page .gt-premium-machine .gt-hw-respin-panel {
+  position: absolute;
+  z-index: 31;
+  top: 186px;
+  left: 50%;
+  width: min(78%, 310px);
+  min-height: 24px;
+  transform: translateX(-50%);
+  grid-template-columns: 1fr auto 1fr;
+  padding: 2px 9px;
+  border-radius: 999px;
+  background: rgba(71,8,4,.88);
+  backdrop-filter: blur(5px);
+}
+
+/* Three physical-looking reel cylinders replace nine independent card surfaces. */
+.gt-hw-page .gt-premium-machine .gt-premium-grid {
+  isolation: isolate;
+  border-radius: 13px;
+  border-width: 3px;
+  background: #2d0705;
+  box-shadow:
+    0 0 0 2px #641007,
+    0 0 0 4px rgba(246,200,93,.22),
+    0 12px 28px rgba(0,0,0,.78),
+    0 0 22px rgba(255,178,43,.20),
+    inset 0 12px 22px rgba(44,4,2,.58),
+    inset 0 -14px 24px rgba(36,3,2,.68);
+}
+
+.gt-hw-page .gt-premium-machine .gt-commercial-reel-cylinder {
+  position: absolute;
+  z-index: 0;
+  top: 0;
+  bottom: 0;
+  width: 33.333333%;
+  pointer-events: none;
+  background:
+    linear-gradient(180deg, rgba(63,10,6,.42) 0%, transparent 13%, transparent 86%, rgba(45,5,3,.58) 100%),
+    radial-gradient(ellipse at 50% 48%, #fff4d2 0%, #efd7aa 45%, #c99a61 76%, #7f431f 100%);
+  box-shadow:
+    inset 12px 0 18px rgba(92,42,16,.14),
+    inset -12px 0 18px rgba(92,42,16,.14),
+    inset 0 16px 18px rgba(76,24,10,.18),
+    inset 0 -18px 20px rgba(61,17,8,.22);
+}
+.gt-hw-page .gt-premium-machine .gt-commercial-reel-cylinder.is-0 { left: 0; }
+.gt-hw-page .gt-premium-machine .gt-commercial-reel-cylinder.is-1 { left: 33.333333%; }
+.gt-hw-page .gt-premium-machine .gt-commercial-reel-cylinder.is-2 { left: 66.666666%; }
+.gt-hw-page .gt-premium-machine .gt-commercial-reel-cylinder.is-1,
+.gt-hw-page .gt-premium-machine .gt-commercial-reel-cylinder.is-2 {
+  border-left: 1px solid rgba(122,62,23,.48);
+}
+
+.gt-hw-page .gt-premium-machine .gt-premium-grid .gt-hw-cell {
+  z-index: 2;
+  border: 0 !important;
+  border-radius: 0 !important;
+  background: transparent !important;
+  box-shadow: none !important;
+}
+.gt-hw-page .gt-premium-machine .gt-premium-grid .gt-hw-cell::before {
+  display: none !important;
+}
+.gt-hw-page .gt-premium-machine .gt-premium-grid .gt-hw-cell.is-winning {
+  background: radial-gradient(circle at 50% 50%, rgba(255,238,145,.30), rgba(255,183,45,.10) 55%, transparent 74%) !important;
+  box-shadow: inset 0 0 22px rgba(255,233,132,.28) !important;
+}
+.gt-hw-page .gt-premium-machine[data-feature-mode="active"] .gt-premium-grid .gt-hw-cell.is-feature-blank {
+  background: rgba(29,4,3,.54) !important;
+  box-shadow: inset 0 0 18px rgba(0,0,0,.38) !important;
+}
+.gt-hw-page .gt-premium-machine[data-feature-mode="active"] .gt-premium-grid .gt-hw-cell.is-locked {
+  background: radial-gradient(circle, rgba(255,221,123,.14), rgba(67,14,6,.20) 68%, transparent 100%) !important;
+}
+
+/* Moving reels are one uninterrupted strip per column; item cells are transparent. */
+.gt-hw-page .gt-premium-machine .gt-hw-reel-overlay {
+  border-radius: 0;
+  background:
+    linear-gradient(180deg, rgba(61,12,7,.38), transparent 14%, transparent 86%, rgba(49,8,5,.48)),
+    radial-gradient(ellipse at 50% 50%, #fff4d4 0%, #ead1a2 58%, #b9824d 100%);
+  box-shadow: inset 12px 0 18px rgba(92,42,16,.14), inset -12px 0 18px rgba(92,42,16,.14);
+}
+.gt-hw-page .gt-premium-machine .gt-hw-reel-overlay + .gt-hw-reel-overlay {
+  border-left: 1px solid rgba(122,62,23,.48);
+}
+.gt-hw-page .gt-premium-machine .gt-hw-reel-item {
+  background: transparent !important;
+  box-shadow: none !important;
+}
+.gt-hw-page .gt-premium-machine .gt-hw-reel-shade {
+  background: linear-gradient(180deg, rgba(55,7,5,.42) 0, transparent 18%, transparent 80%, rgba(55,7,5,.50) 100%);
+  box-shadow: inset 0 14px 18px rgba(58,11,6,.24), inset 0 -16px 20px rgba(58,11,6,.28);
+}
+
+/* One compact message strip, then just Balance / Bet. */
+.gt-hw-page .gt-premium-machine .gt-hw-status {
+  min-height: 28px;
+  border: 0;
+  border-block: 1px solid rgba(229,169,70,.26);
+  border-radius: 0;
+  background: linear-gradient(90deg, transparent, rgba(62,8,5,.72) 18% 82%, transparent);
+  box-shadow: none;
+  font-size: 8px;
+  letter-spacing: .10em;
+}
+.gt-hw-page .gt-premium-machine .gt-hw-hud {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  border-radius: 9px;
+  background: rgba(10,1,1,.72);
+}
+.gt-hw-page .gt-premium-machine .gt-hw-hud > div {
+  background: transparent;
+  box-shadow: none;
+}
+
+/* Secondary actions and spin controls now live on one physical console deck. */
+.gt-hw-page .gt-premium-machine .gt-commercial-console {
+  min-height: 64px;
+  padding: 7px 8px;
+  border: 1px solid rgba(224,170,76,.44);
+  border-radius: 15px 15px 20px 20px;
+  background:
+    linear-gradient(180deg, rgba(112,20,11,.92), rgba(38,4,3,.96)),
+    radial-gradient(ellipse at 50% 0, rgba(255,211,107,.14), transparent 62%);
+  box-shadow:
+    inset 0 1px 0 rgba(255,232,165,.18),
+    inset 0 -10px 18px rgba(0,0,0,.28),
+    0 8px 18px rgba(0,0,0,.34);
+}
+.gt-hw-page .gt-premium-machine .gt-commercial-console .gt-hw-main-controls > button:not(.gt-hw-spin),
+.gt-hw-page .gt-premium-machine .gt-commercial-console .gt-hw-secondary-controls > button {
+  border: 1px solid rgba(230,183,89,.40);
+  background: linear-gradient(180deg, rgba(104,16,9,.90), rgba(48,5,4,.96));
+  box-shadow: inset 0 1px 0 rgba(255,229,151,.12), 0 2px 4px rgba(0,0,0,.26);
+}
+
+.gt-hw-page .gt-premium-machine .gt-premium-feature-title span {
+  letter-spacing: .12em;
+}
+
+@media (max-width: 699px) {
+  .gt-hw-page .gt-premium-machine {
+    grid-template-rows: 42px 142px 0 minmax(300px, 1fr) 28px 38px 66px 9px;
+    gap: 3px;
+    padding-inline: 7px;
+  }
+  .gt-hw-page .gt-premium-machine .gt-hw-respin-panel { top: 180px; }
+  .gt-hw-page .gt-premium-machine .gt-commercial-console {
+    grid-template-columns: 44px minmax(0,1fr) 44px 44px;
+    gap: 4px;
+    padding: 5px 6px;
+  }
+}
+
+@media (min-width: 700px) and (max-height: 800px) {
+  .gt-hw-page .gt-premium-machine {
+    grid-template-rows: 42px 132px 0 minmax(286px,1fr) 28px 36px 62px 8px;
+    gap: 2px;
+    padding: 5px 9px;
+  }
+  .gt-hw-page .gt-premium-machine .gt-hw-tiger-stage {
+    height: 132px;
+    min-height: 132px;
+    margin-bottom: -10px;
+  }
+  .gt-hw-page .gt-premium-machine .gt-hw-respin-panel { top: 170px; }
+  .gt-hw-page .gt-premium-machine .gt-commercial-console { min-height: 58px; padding-block: 4px; }
+}
